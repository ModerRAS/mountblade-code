  char *entryString;                 // 条目字符串指针
  char *defaultString;              // 默认字符串指针
  int64_t stringLength;              // 字符串长度
  int64_t targetLength;              // 目标长度
  int64_t stringOffset;              // 字符串偏移量
  
  // 无限循环查找匹配的条目
  while( true ) {
    // 遍历条目列表直到找到匹配长度的条目
    do {
      entryList = (uint64_t *)entryList[6];
      if (entryList == (uint64_t *)0x0) {
        return (uint64_t *)0x0;
      }
      
      if ((char *)*entryList == (char *)0x0) {
        stringLength = 0;
        entryString = defaultString;
      }
      else {
        stringLength = entryList[2];
        entryString = (char *)*entryList;
      }
    } while (stringLength != targetLength);
    
    compareEnd = entryString + stringLength;
    if (compareEnd <= entryString) break;
    
    stringLength = stringOffset - (int64_t)entryString;
    
    // 逐字符比较字符串内容
    while (*entryString == entryString[stringLength]) {
      entryString = entryString + 1;
      if (compareEnd <= entryString) {
        return entryList;
      }
    }
  }
  
  return entryList;
}



